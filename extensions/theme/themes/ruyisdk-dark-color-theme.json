{
  "$schema": "vscode://schemas/color-theme",
  "name": "RuyiSDK Dark",
  "type": "dark",
  "colors": {
    "activityBar.background": "#131D27",
    "activityBar.foreground": "#E6EDF3",
    "activityBar.inactiveForeground": "#9AA8B5",
    "activityBarBadge.background": "#D6A84F",
    "activityBarBadge.foreground": "#101820",
    "badge.background": "#D6A84F",
    "badge.foreground": "#101820",
    "button.background": "#17324D",
    "button.foreground": "#F4F7FA",
    "button.hoverBackground": "#214665",
    "editor.background": "#101820",
    "editor.foreground": "#E6EDF3",
    "editorLineNumber.foreground": "#758391",
    "editorLineNumber.activeForeground": "#D6A84F",
    "editor.selectionBackground": "#24496A",
    "editor.inactiveSelectionBackground": "#1D3B55",
    "editor.selectionHighlightBackground": "#D6A84F30",
    "editor.wordHighlightBackground": "#D6A84F20",
    "editor.wordHighlightStrongBackground": "#D6A84F35",
    "editor.findMatchBackground": "#D6A84F55",
    "editor.findMatchHighlightBackground": "#D6A84F30",
    "editorCursor.foreground": "#E6B85C",
    "editorWhitespace.foreground": "#43515E",
    "editorIndentGuide.background1": "#293744",
    "editorIndentGuide.activeBackground1": "#526372",
    "editorLineHighlightBackground": "#19242E",
